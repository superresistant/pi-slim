#!/usr/bin/env python3
"""clipclean — detect and clean TUI-mangled clipboard text (X11 CLIPBOARD).

Text copied from terminal UIs has hard line breaks and right-padding baked
in. Detection: most non-empty lines right-padded to one column width.

Usage:
    clipclean          clean clipboard once (kitty-paste, notes)
    clipclean --watch  daemon: poll clipboard every 500 ms
    -q is accepted for compatibility and ignored
"""

import subprocess
import sys
import re
from collections import Counter


def get_clipboard():
    try:
        return subprocess.run(["xclip", "-selection", "clipboard", "-o"],
                              capture_output=True, text=True, timeout=2).stdout
    except (subprocess.TimeoutExpired, FileNotFoundError, UnicodeDecodeError):
        return None


def set_clipboard(text):
    subprocess.run(["xclip", "-selection", "clipboard", "-i"], input=text, text=True, timeout=2)


def detect_tui_paste(text):
    """Return (is_tui, padded_width).

    Heuristic: lines in TUI output are right-padded with spaces to a
    uniform column width.  Normal text never has this.

    A two-line soft wrap commonly has padding only on the first line.
    Accept it when that line filled most of its width and either has at
    least three trailing spaces or both lines share a positive TUI margin.
    """
    lines = text.split("\n")
    if len(lines) < 2:
        return False, 0

    non_empty = [line for line in lines if line]
    raw_lengths = [len(line) for line in non_empty]
    padded_count = sum(line != line.rstrip() for line in non_empty)

    if len(raw_lengths) < 2:
        return False, 0

    common_width, count = Counter(raw_lengths).most_common(1)[0]
    ratio = count / len(raw_lengths)
    padded_ratio = padded_count / len(raw_lengths)

    is_tui = (
        ratio > 0.5
        and common_width > 20
        and padded_count >= 2
        and padded_ratio >= 0.5
    )
    if is_tui:
        return True, common_width

    if len(non_empty) == 2:
        first, second = non_empty
        trailing = len(first) - len(first.rstrip())
        shared_margin = all(len(line) > len(line.lstrip()) for line in non_empty)
        is_tui = (
            len(first) > 20
            and trailing > 0
            and len(first.rstrip()) >= len(first) * 0.8
            and len(second) <= len(first)
            and (trailing >= 3 or shared_margin)
        )
        if is_tui:
            return True, len(first)

    return False, common_width


def _detect_margin(lines):
    """Find the consistent left margin (TUI content padding)."""
    non_empty = [l for l in lines if l.strip()]
    if not non_empty:
        return 0

    indents = [len(l) - len(l.lstrip()) for l in non_empty]
    positive = [i for i in indents if i > 0]
    if not positive:
        return 0

    min_pos = min(positive)
    has_margin = sum(1 for i in indents if i >= min_pos)
    if has_margin / len(indents) > 0.5:
        return min_pos
    return 0


def _is_structure_start(line):
    """True if this line begins a new structural element."""
    s = line
    if re.match(r"^[-*•]\s", s):        return True   # bullet
    if re.match(r"^\d+\.\s", s):        return True   # numbered list
    if re.match(r"^#{1,6}\s", s):       return True   # heading
    if re.match(r"^>\s?", s):           return True   # blockquote
    if re.match(r"^[│┃|]", s):          return True   # table/box line
    return False


def _looks_soft_wrapped(line, content_width):
    """True if line length is close to the content width (TUI broke it).

    Word-wrapping leaves slack — the last word that didn't fit pushes
    the break earlier.  We use 80% of content width as the threshold:
    shorter lines are almost certainly intentional breaks.
    """
    return len(line) >= content_width * 0.8


def clean_tui_paste(text, padded_width=0):
    """Strip padding, unwrap soft-wrapped lines, preserve structure.

    padded_width: the detected terminal column width (from detect_tui_paste).
    Used to decide whether a line was soft-wrapped by the TUI (length ≈
    width - margin) vs. intentionally short.
    """
    lines = text.split("\n")

    # 1. Strip right-padding
    lines = [l.rstrip() for l in lines]

    # 2. Strip left margin
    margin = _detect_margin(lines)
    if margin > 0:
        out = []
        for l in lines:
            if l and (len(l) - len(l.lstrip())) >= margin:
                out.append(l[margin:])
            else:
                out.append(l)
        lines = out

    # Content width = terminal width minus margins on both sides.
    # If we don't know the padded width, fall back to aggressive joining.
    content_width = padded_width - margin if padded_width else 0

    # 3. Reassemble: join wrapped lines, respect structure
    result = []
    in_code = False
    i = 0

    while i < len(lines):
        line = lines[i]

        # code fence
        if line.strip().startswith("```"):
            in_code = not in_code
            result.append(line)
            i += 1
            continue

        # inside code block: preserve verbatim
        if in_code:
            result.append(line)
            i += 1
            continue

        # blank line → paragraph break
        if not line.strip():
            result.append("")
            i += 1
            continue

        # collect a paragraph: only join the next line if the current
        # line was soft-wrapped (its length ≈ content width)
        parts = [line]
        i += 1
        while i < len(lines):
            nxt = lines[i]
            if not nxt.strip():                break   # blank → end paragraph
            if nxt.strip().startswith("```"):  break   # code fence
            if _is_structure_start(nxt):       break   # bullet / heading
            # Only join if the previous line was soft-wrapped by the TUI.
            # A short line = intentional break → stop joining.
            prev = parts[-1]
            if content_width and not _looks_soft_wrapped(prev, content_width):
                break
            parts.append(nxt.strip())
            i += 1

        result.append(" ".join(parts))

    text = "\n".join(result)
    text = re.sub(r"\n{3,}", "\n\n", text)   # collapse runs of blanks
    return text.strip()


def cleaned(text):
    is_tui, width = detect_tui_paste(text)
    return clean_tui_paste(text, padded_width=width) if is_tui else None


def watch():
    import time
    last = None
    while True:
        text = get_clipboard()
        if text and text != last:
            last = cleaned(text) or text
            if last != text:
                set_clipboard(last)
        time.sleep(0.5)


if __name__ == "__main__":
    if "--watch" in sys.argv[1:]:
        watch()
    text = get_clipboard()
    if text is None:
        sys.exit(1)
    result = cleaned(text)
    if result is not None:
        set_clipboard(result)
