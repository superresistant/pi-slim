#!/usr/bin/env python3
"""Open a file reference in Kitty: text in an editor split next to the source window, images via icat in a split; --elsewhere, directories and other files with the desktop default app.

usage: kitty-open-file [--elsewhere] [--window ID] REF
REF: path[:line[:col]], path#Lline, or file:// URL; relative paths resolve against the current directory.
"""
import argparse
import os
import re
import shutil
import subprocess
from urllib.parse import unquote, urlparse

TEXT_TYPES = {"application/json", "application/xml", "application/javascript", "application/x-sh",
              "application/toml", "application/x-yaml", "application/x-ndjson", "inode/x-empty"}


def parse(ref):
    line = col = None
    if ref.startswith("file://"):
        url = urlparse(ref)
        path = unquote(url.path)
        found = re.fullmatch(r"L?(\d+)(?:[:C](\d+))?", url.fragment)
        if found:
            line, col = found.groups()
    else:
        found = re.fullmatch(r"(.+?)(?:#L(\d+)|:(\d+)(?::(\d+))?)?", ref)
        path, hash_line, line, col = found.groups()
        line = hash_line or line
    return os.path.abspath(os.path.expanduser(path)), line, col


def mime(path):
    return subprocess.run(["file", "--brief", "--mime-type", path], capture_output=True, text=True).stdout.strip()


def editor_command(path, line, col):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "micro"
    name = os.path.basename(editor.split()[0])
    position = []
    if line:
        if name == "micro":
            position = [f"+{line}:{col}" if col else f"+{line}"]
        elif name == "nano":
            position = [f"+{line},{col}" if col else f"+{line}"]
        elif name in ("vi", "vim", "nvim", "hx", "emacs", "kak"):
            position = [f"+{line}"]
    return editor.split() + position + [path]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--elsewhere", action="store_true")
    parser.add_argument("--window", default=os.environ.get("KITTY_WINDOW_ID", ""))
    parser.add_argument("ref")
    args = parser.parse_args()
    path, line, col = parse(args.ref)
    if not os.path.exists(path):
        return 1
    kind = "" if os.path.isdir(path) else mime(path)
    if kind.startswith("text/") or kind in TEXT_TYPES:
        command = editor_command(path, line, col)
    elif kind.startswith("image/") and kind != "image/svg+xml":
        command = [shutil.which("kitten") or "kitten", "icat", "--hold", path]
    else:
        command = None
    if args.elsewhere or command is None or not args.window.isdigit() or not os.environ.get("KITTY_LISTEN_ON"):
        subprocess.Popen(["xdg-open", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return 0
    return subprocess.run(["kitten", "@", "--to", os.environ["KITTY_LISTEN_ON"], "launch", "--next-to", f"id:{args.window}",
                           "--location=vsplit", "--cwd", os.path.dirname(path), "--title", os.path.basename(path), *command],
                          stdout=subprocess.DEVNULL).returncode


raise SystemExit(main())
